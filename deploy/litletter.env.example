# Keep this file readable only by the litletter service account.
LITLETTER_POSTMARK_TOKEN=replace-with-your-postmark-server-token
# Optional: raises the NCBI request allowance from 3 to 10 requests per second.
# LITLETTER_NCBI_API_KEY=replace-with-your-ncbi-api-key
# Required when the newsletter enables DeepSeek summarization.
LITLETTER_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
