{
  "version": 2,
  "database": "state/litletter.sqlite3",
  "newsletter": {
    "title": "My Litletter",
    "from": "Litletter <newsletter@updates.example.com>",
    "to": ["you@example.com"],
    "timezone": "Europe/London",
    "include_abstracts": false,
    "abstract_max_characters": 800
  },
  "sources": {
    "pubmed": {
      "enabled": true,
      "provider": "pubmed-default"
    },
    "biorxiv": {
      "enabled": true
    }
  },
  "discovery": {
    "initial_lookback_days": 30,
    "overlap_days": 2
  },
  "categories": [
    {
      "id": "nsc-cancer",
      "name": "Nature, Science and Cell: Cancer",
      "query": "title_abstract:cancer AND journal_group:flagship_nsc AND publication_type:original_research",
      "sources": ["pubmed"]
    },
    {
      "id": "cancer-preprints",
      "name": "Cancer Preprints",
      "query": "title_abstract:cancer AND publication_type:original_research",
      "sources": ["biorxiv"]
    }
  ],
  "summarization": {
    "enabled": true,
    "provider": "deepseek-default",
    "model": "deepseek-v4-flash",
    "max_words": 100,
    "audience": "a scientifically literate reader outside the paper's specialty",
    "failure_policy": "fallback"
  },
  "delivery": {
    "provider": "resend-default"
  }
}
